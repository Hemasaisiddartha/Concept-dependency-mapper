# Database Configuration
DATABASE_URL=sqlite:///./data/concept_mapper.db

# ==============================================================================
# GMAIL SMTP CONFIGURATION (For Real Email OTP Delivery)
# ==============================================================================
# To deliver OTPs directly to user Gmail inboxes:
# 1. Enter your Gmail address in SMTP_USER and SMTP_FROM_EMAIL.
# 2. Generate a 16-character Google "App Password":
#    - Go to https://myaccount.google.com/security
#    - Enable "2-Step Verification" (if not already enabled)
#    - Search for "App Passwords" (or visit https://myaccount.google.com/apppasswords)
#    - Create an app password named "ConceptMapper"
#    - Copy the 16-character password and paste it below in SMTP_PASSWORD
# ==============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
